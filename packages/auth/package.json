    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@userbubble/db": "workspace:*",
    "@better-auth/expo": "catalog:",
    "@t3-oss/env-core": "^0.13.8",
    "better-auth": "catalog:",
    "zod": "catalog:",
    "@better-auth/agent-auth": "0.6.2",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/cimd": "1.7.7"
  },
  "devDependencies": {
    "@userbubble/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "auth": "1.7.7"
  }
}
